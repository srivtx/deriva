{
  "name": "rig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RIG — a Teenage-Engineering-styled remote coding harness. Local daemon + PWA cockpit.",
  "scripts": {
    "dev:daemon": "tsx watch daemon/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "rig": "vite build && tsx daemon/server.ts"
  },
  "dependencies": {
    "nanoid": "^5.0.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
